PP_SITE_BUCKET=                            # required for infra/deploy.sh. Convention:
                                            # prefix with today's date as YYMMDD,
                                            # e.g. 260930-purple-plotter-outputs
PP_CLOUDFRONT_DISTRIBUTION_ID=             # required for infra/deploy.sh
AWS_REGION=eu-west-2                       # used by infra/bootstrap.sh
# infra/deploy.sh and infra/bootstrap.sh also need AWS_PROFILE set (and
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY unset) for the target account --
# not read from this file, export it in your shell before running.
